# Copy to .env for local development (never commit .env)

PORT=5000
NODE_ENV=development

# MongoDB — local or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/forever-yours

# Cloudinary server credentials (never expose these in frontend code)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private HMAC key used to verify creator and viewer tokens. Use a random 32+ character value.
CREATOR_KEY_SECRET=
MAX_PHOTO_SIZE_MB=8

# Proposal data lifetime (hours)
PROPOSAL_TTL_HOURS=24
PROPOSAL_DRAFT_TTL_HOURS=72

# Local dev: leave empty OR list your dev URLs (localhost any port is allowed in development)
# Production: your live frontend origin, no trailing slash
ALLOWED_ORIGINS=https://love-xa-1-0.vercel.app
